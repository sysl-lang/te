// `te [file]`: edits `file`, a new file of that name if there is none, or an unnamed buffer.
//
// Everything the editor decides is in `Editor` (`editor.sysl`), which draws into a `Grid`; this file
// is the terminal: it turns termbox's events into `Input`, copies the grid to the screen, and sends
// what the editor has for the terminal itself (OSC 52). While a search runs, or lines are still to be
// counted, it runs a step of that whenever no key is waiting, so the screen stays live and Esc can
// stop a search.

import sysl.fs.Interrupted
import sysl.text.char_from_u32
import sysl.time.monotonic
import sh.sysl.termbox2.{Event, Keyboard, Resize, Mouse, EventKind, UnknownEvent, Key, InputMode, init, shutdown, width, height, clear, set_cell, set_cluster, enable_bracketed_paste, set_cursor, hide_cursor, present, poll_event, peek_event, send, set_input_mode}

main(args: []string) -> Result[unit, string]
    if args.len > 2 then return Err("usage: te [file]")

    var ed = load(if args.len == 2 then args[1] else "")?

    init().map_err(e -> s"cannot start the terminal: ${e.message()}")?

    val ran = run(&ed)

    shutdown().unwrap_or(())
    ran
end main

/** Draws, waits for input, and does what it asks, until the editor is done. */
run(ed: *Editor) -> Result[unit, string]
    set_input_mode(InputMode(false, true)).map_err(e -> e.message())?
    enable_bracketed_paste().map_err(e -> e.message())?
    ed.handle(Resized(width().unwrap_or(80), height().unwrap_or(24)))

    var g = grid()
    var stale = true

    loop
        // A step of counting that changed nothing on screen sends nothing to the terminal.
        if stale
            ed.render(&g)
            show(g, ed)
        if ed.done then return Ok(())

        val next = if ed.pending() then peek_event(0) else poll_event().map(e -> Some(e))

        stale = next match
            // A search the key started gets one step before the screen is drawn, so a search that
            // is short (most are) never shows as running.
            Ok(Some(ev)) ->
                if input_of(ev) is Some(i)
                    ed.clock = monotonic().us / 1000
                    ed.handle(i)
                    if ed.busy() then ed.work(search_step)
                true
            Ok(None) -> ed.work(search_step)
            Err(e) ->
                if e.errno() != Interrupted.code() then return Err(e.message())
                true
end run

/** What an event asks the editor, if anything. */
input_of(ev: Event) -> Option[Input] = ev.kind match
    Keyboard -> if ev.ch != 0 then char_from_u32(ev.ch).map(c -> Type(c)) else Some(Press(ev.key, ev.ctrl(), ev.shift()))
    Resize -> Some(Resized(ev.w, ev.h))
    Mouse -> ev.key match
        MouseLeft -> Some(if ev.motion() then Drag(ev.x, ev.y) else Click(ev.x, ev.y))
        MouseWheelUp -> Some(Wheel(-3))
        MouseWheelDown -> Some(Wheel(3))
        _ -> None
    EventKind.Paste -> Some(Input.Paste(ev.text))
    UnknownEvent -> None

/** Copies the grid to termbox's back buffer, adds what the editor has for the terminal itself, and
 * sends what changed.
 */
show(g: Grid, ed: *Editor)
    clear().unwrap_or(())
    for y in 0..<g.h
        for x in 0..<g.w
            val cell = g.at(x, y)

            if cell.ch != 0 && cell.marks.len > 0
                if set_cluster(x, y, cell.cluster(), cell.fg, cell.bg) is Err(_) then set_cell(x, y, cell.ch, cell.fg, cell.bg).unwrap_or(())
            elif cell.ch != 0
                set_cell(x, y, cell.ch, cell.fg, cell.bg).unwrap_or(())

    if g.cursor is Some((x, y)) then set_cursor(x, y).unwrap_or(()) else hide_cursor().unwrap_or(())
    if ed.outbox.len() > 0
        send(ed.outbox.view()).unwrap_or(())
        ed.outbox.clear()

    present().unwrap_or(())
end show

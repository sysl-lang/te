// `te <file>`: for now, opens the file and says what it holds. The editing view comes next
// (`docs/design.md § Milestones`).

main(args: []string) -> Result[unit, string]
    if args.len != 2 then return Err("usage: te <file>")

    var t = open(args[1]).map_err(e -> s"${args[1]}: $e")?

    print(s"${args[1]}: ${t.size()} bytes, ${t.line_count()} lines")
    Ok(())

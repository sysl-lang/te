@include("<sys/mman.h>")

import sysl.fs.Mapped
import sysl.slices.as_ptr

// A file's bytes are mapped by `sysl.fs.map_file` and never copied. This module only adds the advice
// the library has no call for: that a range already read is not needed for now.

c const
    MADV_DONTNEED: int = "MADV_DONTNEED"

private extern "madvise" c_madvise(addr: *u8, len: usize, advice: int) -> int
private extern "getpagesize" c_getpagesize() -> int

/** Tells the kernel the whole pages inside `from..<from + len` of `m` are not needed for now, so
 * reading through a file of many gigabytes once -- counting its lines -- does not leave all of it in
 * the process's resident set. The bytes are the file's and never written, so a later read faults them
 * back in from the page cache, unchanged.
 *
 * Linux drops the pages from the mapping. macOS takes the advice and keeps them mapped: there the
 * resident size `ps` reports grows to the bytes read, every one of them a clean page of the file
 * that the kernel reclaims whenever it needs the memory, and the process's footprint does not grow.
 */
release(m: &Mapped, from: u64, len: u64)
    val page = u64(c_getpagesize())
    val lo = (from + page - 1) / page * page
    val hi = (from + len) / page * page

    if hi > lo then c_madvise(&as_ptr(m.bytes())[usize(lo)], usize(hi - lo), MADV_DONTNEED)

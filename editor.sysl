// The editor without the terminal: the cursor, the viewport, what each key does, and what the screen
// shows, over a `Text`.
//
// **Only the rows on screen are ever read.** The cursor is a byte offset and the line it is on; both
// are kept as it moves, so nothing asks the core which line an offset is on (which would count every
// line before it). A move to another line asks where that line starts, which finds it without
// counting the lines after it, so the view of a file of many gigabytes reads the pieces it shows.
// The line total is shown once the core knows it, and never counted to be shown.
//
// **A column on screen is not a column in the text.** The core counts characters; the screen counts
// cells, and a tab reaches to the next multiple of `tab`, an East Asian wide character takes two, a
// combining mark none. The cursor moves over a character and the marks after it as one, and an up or
// down move keeps the screen column it started from (`goal`) until a move along the line.
//
// Each edit is one version of the text, and the cursor before and after it is kept beside the
// version, so an undo puts the cursor back where the edit was made. **One undo step is one thing the
// reader did**, which is sometimes several versions folded into one (`group`): a replaced selection
// (a delete and an insert), a paste, a replace-all, and a run of typing. A run of typed characters is
// one step until the cursor is moved or anything else is done, a second passes without a key, or a
// letter or digit is typed after a space or punctuation -- so each word, with the spaces after it,
// is one step. A run of Backspace and Delete is one step by the same rules, less the word rule.
//
// **The selection is the text between the cursor and an anchor**, both byte offsets. Only the cursor
// keeps its line; the anchor's line is asked for when the cursor is put there, so selecting all of
// a file of many gigabytes reads none of it. **The clipboard is a slice of the text** -- the pieces
// that held the copied bytes, shared rather than copied -- so a copy, a cut and a paste of any size
// cost O(log n) and read nothing, and the system clipboard is sent the text, by OSC 52, up to
// `osc52_limit`.
//
// **A search is a job the screen stays live through.** It reads the text a window at a time from
// the cursor (`work`), wrapping at the end, and the terminal's loop runs a window whenever no key is
// waiting, so Esc stops it and the status bar shows how far it has got.

import sysl.buf.{Buf, buf}
import sysl.fs.{IoError, NotFound}
import sysl.math.{min, max}
import sysl.text.{chars_of, from_utf8_lossy, parse_ulong, split}
import sh.sysl.termbox2.{Key, wcwidth, DEFAULT, REVERSE, DIM, BOLD}

/** How many columns a tab reaches to a multiple of. */
const tab_width: u64 = 4

/** How long, in milliseconds, a pause in typing may be and the typing still be one undo step. */
const streak_pause: long = 1000

/** How soon, in milliseconds, a second click in the same place is a double click. */
const double_click: long = 400

/** How much of the text a search reads, or the line counting counts, in one step between keys. */
const search_step: u64 = 4 << 20

/** How long a line may be, in bytes, and still be laid out cell by cell. A longer one -- a minified
 * file, a log with no line breaks -- is laid out a byte to a column, so where the cursor is on screen
 * is a subtraction and nothing walks the line from its start; the status bar says `Byte` there in
 * place of `Col`. A word move goes no further than this either.
 */
const long_line: u64 = 1 << 15

/** A file this large or larger has its size said when it is opened. */
const big_file: u64 = 64 << 20

/** What the editor is told: the terminal's input, already named. */
enum Input
    /** A character typed. */
    Type(c: char)
    /** A key that is not a character, with whether Ctrl and Shift were held. */
    Press(key: Key, ctrl: bool, shift: bool)
    /** A click at a screen position. */
    Click(x: int, y: int)
    /** The mouse moved to a screen position with the button held. */
    Drag(x: int, y: int)
    /** Text the terminal says was pasted, all at once. */
    Paste(text: string)
    /** The wheel, in lines: positive scrolls down. */
    Wheel(lines: int)
    /** The terminal's new size. */
    Resized(w: int, h: int)

/** What the status bar is asking, if anything. */
enum Prompt
    Idle
    /** "Save changes?" before quitting with unsaved changes. */
    Quitting
    /** A line number to go to. */
    GoingTo
    /** A name to save an unnamed buffer as. */
    Naming
    /** Text to find, searched for as it is typed. */
    Finding
    /** Text to replace. */
    Replacing
    /** What to replace it with. */
    ReplacingWith
    /** Whether to replace the match selected. */
    Confirming
    /** Whether to save over a file that has changed on disk since it was opened. */
    Overwriting

/** A cursor: its offset and the line it is on. */
type Spot = (u64, u64)

/** What the last edit was part of, which the next edit may join. */
enum Streak
    Quiet
    Typing
    Erasing

/** What a search does with a match. */
enum Goal
    /** Selects it. */
    Show
    /** Selects it and asks whether to replace it. */
    Ask
    /** Replaces it, and every one after it. */
    ReplaceAll

/** A search in progress. Matches start in `pos..<limit` going forward, or `limit..<pos` going back;
 * once that is looked through, the rest of the text is, from the other end back to `origin`.
 */
struct Hunt
    goal: Goal
    back: bool
    pos: u64
    limit: u64
    origin: u64
    wrapped: bool

    /** How many bytes have been looked through, for the progress shown. */
    done: u64

    /** A replace-all's replacements so far, the version before the first, and the cursor it keeps. */
    count: u64
    since: usize
    keep: u64

struct Editor
    text: Text

    /** The cursor, at the start of a character, never past its line's text. */
    at: u64
    line: u64

    /** The screen column an up or down move aims for, kept until a move along the line. */
    goal: Option[u64]

    /** The first line on screen, and the first screen column of the text. */
    top: u64
    left: u64

    w: int
    h: int
    tab: u64

    prompt: Prompt
    entry: Buf[u8]

    /** Whether the save the prompt is for is the last thing before quitting. */
    quit_after: bool

    /** What the status bar says until the next key. */
    message: string

    /** Set when the editor is to exit. */
    done: bool

    /** The cursor before and after the edit that made each version, by version. */
    before: Buf[Spot]
    after: Buf[Spot]

    /** The other end of the selection from the cursor, if there is a selection. */
    anchor: Option[u64]

    /** What Ctrl+C or Ctrl+X took: a slice of the text. */
    clip: Option[&Node]

    /** Bytes for the terminal rather than the screen: OSC 52, for the system clipboard. */
    outbox: Buf[u8]

    /** The time, in milliseconds from any fixed start, of the input being handled. Whoever feeds the
     * editor its input sets it.
     */
    clock: long

    /** The run the last edit was part of, the one before the input being handled, and the last
     * character and time in it.
     */
    streak: Streak
    last_streak: Streak
    streak_char: char
    streak_clock: long

    /** When and where the last click was. */
    click_clock: long
    click_at: (int, int)

    /** The text searched for, its replacement, and whether case matters. */
    query: Buf[u8]
    replacement: Buf[u8]
    match_case: bool

    /** Whether the query's matches on screen are shown. */
    lit: bool

    /** Where the cursor was when the find prompt opened: a search as the query is typed starts here. */
    origin: Spot

    hunt: Option[Hunt]

    /** How many bytes searches have read. */
    searched: u64

    /** Set when Ctrl+End went to the end before the lines were counted: the cursor is at the end, its
     * line is not known, and the screen shows the lines `far_rows` start at, found by reading back from
     * the end. It ends when the counting does, or at a key that needs the cursor's line, which then
     * counts the rest at once.
     */
    far: bool
    far_rows: Buf[u64]

    /** The syntax colours, and the lines on screen already tokenized. Ctrl+E turns them off and on. */
    colours: Colours

    // ---- layout ------------------------------------------------------------------------------

    /** The number of text rows: the screen less the status bar and the key bar. */
    rows(self) -> u64 = if self.h > 2 then u64(self.h - 2) else 1

    /** The gutter's width: the digits of the last line number it may show, and a space. */
    gutter(*self) -> u64
        val last = if self.text.lines_known() then
            self.text.line_count()
        elif self.far then
            self.text.lines_at_least()
        else
            self.top + self.rows()

        digits(last) + 1

    /** How many screen columns of text are shown beside the gutter. */
    text_width(*self) -> u64
        val g = self.gutter()

        if u64(self.w) > g + 1 then u64(self.w) - g else 1

    // ---- reading the text --------------------------------------------------------------------

    /** Whether line `n` exists: the text has `n` line breaks. */
    has_line(*self, n: u64) -> bool
        if n == 0 then return true

        val s = self.text.line_start(n)

        s > 0 && self.text.byte_at(s - 1) == u8('\n') && self.text.line_start(n - 1) < s

    /** The last line, which counts every line break once. */
    last_line(*self) -> u64 = self.text.line_of(self.text.size())

    /** The character at `at` and how many bytes it takes. */
    char_at(*self, at: u64) -> (char, u64)
        val chunk = self.text.chunk_at(at)

        if chunk.len >= 4 then return first_char(chunk[0..<4])

        first_char(self.text.bytes(at, min(at + 4, self.text.size())).view())

    /** Where line `line`'s text starts and ends. */
    bounds(*self, line: u64) -> (u64, u64) = (self.text.line_start(line), self.text.line_end(line))

    /** The screen column of `at` on line `line`, and its column in characters. */
    column(*self, line: u64, at: u64) -> (u64, u64)
        val (start, end) = self.bounds(line)

        self.column_in(start, end, at)

    /** The screen column of `at` on the line whose text is `start..<end`, and its column in
     * characters; on a long line, both are bytes from the start.
     */
    column_in(*self, start: u64, end: u64, at: u64) -> (u64, u64)
        if end - start > long_line then return (at - start, at - start)

        var off = start
        var col: u64 = 0
        var chars: u64 = 0

        while off < at
            val (c, len) = self.char_at(off)

            col += cells(c, col, self.tab)
            chars += 1
            off += len

        (col, chars)
    end column_in

    /** The offset on line `line` nearest screen column `goal` without passing it: a column inside a
     * tab or a wide character is the start of it.
     */
    at_column(*self, line: u64, goal: u64) -> u64
        val (start, end) = self.bounds(line)

        self.at_column_in(start, end, goal)

    /** `at_column` on the line whose text is `start..<end`. On a long line a column is a byte, and one
     * inside a character or on a combining mark is the start of the character the mark is on.
     */
    at_column_in(*self, start: u64, end: u64, goal: u64) -> u64
        if end - start > long_line
            if goal >= end - start then return end

            var at = self.text.char_start(start + goal)

            while at > start && is_mark(self.char_at(at).0) do at = self.text.char_start(at - 1)
            return at

        var off = start
        var col: u64 = 0

        while off < end
            val (c, len) = self.char_at(off)
            val span = cells(c, col, self.tab)

            if span > 0 && col + span > goal then break
            col += span
            off += len

        off
    end at_column_in

    /** Past the character at `at` and the combining marks after it. */
    cluster_end(*self, at: u64, end: u64) -> u64
        var off = at + self.char_at(at).1

        while off < end && is_mark(self.char_at(off).0) do off += self.char_at(off).1
        off

    /** Back to the start of the character before `at`, past any combining marks on it. */
    cluster_start(*self, at: u64, start: u64) -> u64
        var off = self.text.char_start(at - 1)

        while off > start && is_mark(self.char_at(off).0) do off = self.text.char_start(off - 1)
        off

    /** Where line `line`'s indentation ends. */
    indent_end(*self, line: u64) -> u64
        var off = self.text.line_start(line)
        val end = min(self.text.line_end(line), off + long_line)

        while off < end && is_blank(self.text.byte_at(off)) do off += 1
        off

    // ---- moving ------------------------------------------------------------------------------

    place(*self, at: u64, line: u64)
        self.at = at
        self.line = line
        self.goal = None
        self.far = false

    left_one(*self)
        val start = self.text.line_start(self.line)

        if self.at > start then
            self.place(self.cluster_start(self.at, start), self.line)
        elif self.line > 0 then
            self.place(self.text.line_end(self.line - 1), self.line - 1)

    right_one(*self)
        val end = self.text.line_end(self.line)

        if self.at < end then
            self.place(self.cluster_end(self.at, end), self.line)
        elif self.has_line(self.line + 1) then
            self.place(self.text.line_start(self.line + 1), self.line + 1)

    word_left(*self)
        val start = self.text.line_start(self.line)

        if self.at <= start then return self.left_one()

        val stop = max(start, self.at - min(self.at, long_line))
        var off = self.at

        while off > stop && !is_word(self.char_at(self.text.char_start(off - 1)).0) do off = self.text.char_start(off - 1)
        while off > stop && is_word(self.char_at(self.text.char_start(off - 1)).0) do off = self.text.char_start(off - 1)
        self.place(off, self.line)
    end word_left

    word_right(*self)
        val end = self.text.line_end(self.line)

        if self.at >= end then return self.right_one()

        val stop = min(end, self.at + long_line)
        var off = self.at

        while off < stop && !is_word(self.char_at(off).0) do off += self.char_at(off).1
        while off < stop && is_word(self.char_at(off).0) do off += self.char_at(off).1
        self.place(off, self.line)
    end word_right

    /** Up (`by` negative) or down `by` lines, as far as there are lines, aiming for the goal column. */
    vertical(*self, by: i64)
        val goal = self.goal match
            Some(g) -> g
            None -> self.column(self.line, self.at).0

        var line = self.line

        if by < 0 then
            line -= min(line, u64(-by))
        elif self.has_line(line + u64(by)) then
            line += u64(by)
        elif self.has_line(line + 1) then
            line = self.last_line()

        self.at = self.at_column(line, goal)
        self.line = line
        self.goal = Some(goal)
    end vertical

    /** A page up or down: the view moves a page, and the cursor with it. */
    page(*self, by: i64)
        val rows = self.rows()

        self.vertical(by * i64(rows))
        if by < 0 then
            self.top -= min(self.top, rows)
        else
            self.top = min(self.top + rows, self.line)

    /** Home goes to the end of the indentation, and from there to the start of the line. */
    home(*self)
        val indent = self.indent_end(self.line)

        self.place(if self.at != indent then indent else self.text.line_start(self.line), self.line)

    /** Line `n` (from 0), or the last line for one past it, at character column `col` -- a byte on a
     * long line -- shown in the middle of the screen.
     */
    goto(*self, n: u64, col: u64)
        val line = if self.has_line(n) then n else self.last_line()
        val half = self.rows() / 2
        val (start, end) = self.bounds(line)
        val at = if end - start > long_line then self.at_column_in(start, end, col) else self.text.offset_at(line, col)

        self.place(at, line)
        self.top = if line > half then line - half else 0

    /** Ctrl+End: the end of the text. Where the lines are not all counted after one more step of
     * counting, the cursor goes to the end without its line (`far`), and the screen shows the lines
     * before it, read back from the end.
     */
    to_end(*self)
        if self.text.lines_known() || self.text.count_some(search_step) then return self.place(self.text.size(), self.last_line())

        self.at = self.text.size()
        self.goal = None
        self.far = true
        self.line = self.text.lines_at_least() - 1
        self.frame_far()

    /** The starts of the last lines of the text, as many as fit on the screen, top first. */
    frame_far(*self)
        var starts: Buf[u64] = buf()
        var s = self.text.start_before(self.text.size())

        loop
            starts.push(s)
            if s == 0 || u64(starts.len()) >= self.rows() then break
            s = self.text.start_before(s - 1)

        self.far_rows.clear()
        while starts.pop() is Some(x) do self.far_rows.push(x)

    /** Where the text of the `i`th line on a `far` screen starts and ends. */
    far_line(*self, i: usize) -> (u64, u64)
        val start = self.far_rows[i]

        if i + 1 == self.far_rows.len() then return (start, self.text.size())

        val next = self.far_rows[i + 1] - 1

        (start, if next > start && self.text.byte_at(next - 1) == u8('\r') then next - 1 else next)

    /** Where the text of the cursor's line starts and ends. */
    cursor_line(*self) -> (u64, u64) = if self.far then self.far_line(self.far_rows.len() - 1) else self.bounds(self.line)

    /** The cursor's line found, after a `far` Ctrl+End: free once the lines are counted, and otherwise
     * the rest of them counted now.
     */
    settle(*self)
        if !self.far then return

        self.far = false
        self.line = self.text.line_count() - 1
        self.follow()

    /** Keys that need no line for the cursor, which a `far` cursor keeps: to either end, Esc, saving
     * and quitting, and the answers to the save and quit prompts.
     */
    stays_far(self, input: Input) -> bool
        if self.prompt == Quitting || self.prompt == Naming || self.prompt == Overwriting then return true

        input match
            Press(key, ctrl, _) -> key match
                Home | End -> ctrl
                Esc | CtrlS | CtrlQ -> true
                _ -> false
            _ -> false

    // ---- editing -----------------------------------------------------------------------------

    /** Records the edit just made: the cursor before it, and where it is now. */
    edited(*self, before: Spot)
        val now = self.text.now

        self.before.truncate(now)
        self.after.truncate(now)
        self.before.push(before)
        self.after.push((self.at, self.line))
        self.goal = None
        self.anchor = None

    /** Makes the versions after `since` one undo step, which puts the cursor back where it was
     * before the first of them.
     */
    group(*self, since: usize)
        if self.text.now <= since + 1 then return

        val after = self.after[self.text.now]

        self.text.squash(since)
        self.before.truncate(since + 2)
        self.after.truncate(since + 2)
        self.after.set(since + 1, after)

    /** Folds the edit just made, which made version `since + 1`, into the one before it when both
     * belong to one run of `kind` (the rules are at the top of this file). `c` is the character
     * typed.
     */
    run_on(*self, kind: Streak, c: char, since: usize)
        val word_starts = kind == Typing && is_word(c) && !is_word(self.streak_char)
        val saved_between = self.text.saved == Some(since)

        if self.last_streak == kind && since > 0 && self.clock - self.streak_clock <= streak_pause && !word_starts && !saved_between
            self.group(since - 1)

        self.streak = kind
        self.streak_char = c
        self.streak_clock = self.clock
    end run_on

    /** A typed character, over the selection if there is one. */
    type_char(*self, c: char)
        val since = self.text.now

        if self.erase()
            self.insert(string(c).bytes)
            self.group(since)
        else
            self.insert(string(c).bytes)
            self.run_on(Typing, c, since)

    /** Backspace or Delete: the selection if there is one, else the character on that side. */
    erase_key(*self, back: bool)
        if self.erase() then return

        val since = self.text.now

        if back then self.backspace() else self.delete()
        self.run_on(Erasing, ' ', since)

    /** Enter, over the selection if there is one. */
    enter(*self)
        val since = self.text.now

        self.erase()
        self.newline()
        self.group(since)

    insert(*self, bytes: []const u8)
        if bytes.len == 0 then return

        val before = (self.at, self.line)

        self.colours.edit(self.at, 0, bytes.len)
        self.text.insert(self.at, bytes)
        self.at += bytes.len
        for b in bytes do if b == u8('\n') then self.line += 1
        self.edited(before)

    /** Removes `from..<to`, leaving the cursor at `from` on line `line`. */
    remove(*self, from: u64, to: u64, line: u64)
        val before = (self.at, self.line)

        self.colours.edit(from, to - from, 0)
        self.text.delete(from, to - from)
        self.at = from
        self.line = line
        self.edited(before)

    /** A line break of the kind the line already ends with, and the line's indentation up to the
     * cursor.
     */
    newline(*self)
        val start = self.text.line_start(self.line)
        val crlf = self.text.line_start(self.line + 1) - self.text.line_end(self.line) == 2
        var bytes: Buf[u8] = buf()

        bytes.extend(if crlf then "\r\n".bytes else "\n".bytes)
        bytes.extend(self.text.bytes(start, min(self.indent_end(self.line), self.at)).view())
        self.insert(bytes.view())

    backspace(*self)
        val start = self.text.line_start(self.line)

        if self.at > start then
            self.remove(self.text.char_start(self.at - 1), self.at, self.line)
        elif self.line > 0 then
            self.remove(self.text.line_end(self.line - 1), self.at, self.line - 1)

    delete(*self)
        val end = self.text.line_end(self.line)

        if self.at < end then
            self.remove(self.at, self.cluster_end(self.at, end), self.line)
        elif self.has_line(self.line + 1) then
            self.remove(end, self.text.line_start(self.line + 1), self.line)

    undo(*self)
        self.anchor = None
        self.colours.forget()
        if self.text.undo() then
            val (at, line) = self.before[self.text.now + 1]

            self.place(at, line)

    redo(*self)
        self.anchor = None
        self.colours.forget()
        if self.text.redo() then
            val (at, line) = self.after[self.text.now]

            self.place(at, line)

    // ---- the selection and the clipboard -----------------------------------------------------

    /** The selected bytes, `from..<to`, if any are. */
    selection(self) -> Option[(u64, u64)]
        if self.anchor is Some(a) && a != self.at then return Some((min(a, self.at), max(a, self.at)))

        None

    /** The line `at` is on, which is the cursor's own when it is the cursor. */
    line_at(*self, at: u64) -> u64 = if at == self.at then self.line else self.text.line_of(at)

    /** Before a move: with Shift it starts the selection where the cursor is, or keeps the one there
     * is; without, it drops it.
     */
    extend(*self, shift: bool)
        if !shift
            self.anchor = None
        elif self.anchor is None
            self.anchor = Some(self.at)

    /** Left or Right with a selection and no Shift: the cursor goes to that end of it. */
    collapse(*self, start: bool) -> bool
        if self.selection() is Some((from, to))
            val at = if start then from else to

            self.place(at, self.line_at(at))
            self.anchor = None
            return true

        false

    /** Deletes the selection; false where there is none. */
    erase(*self) -> bool
        if self.selection() is Some((from, to))
            self.remove(from, to, self.line_at(from))
            return true

        false

    /** Everything: from the end to the start when the line total is not known yet, so that nothing
     * is read to find the last line.
     */
    select_all(*self)
        if self.text.lines_known()
            self.anchor = Some(0)
            self.place(self.text.size(), self.last_line())
        else
            self.anchor = Some(self.text.size())
            self.place(0, 0)

    /** The word at the cursor, or the one character there when it is not in a word. */
    select_word(*self)
        val start = self.text.line_start(self.line)
        val end = self.text.line_end(self.line)

        if self.at >= end then return

        var from = self.at
        var to = self.cluster_end(self.at, end)

        if is_word(self.char_at(self.at).0)
            val lo = max(start, self.at - min(self.at, long_line))
            val hi = min(end, self.at + long_line)

            while from > lo && is_word(self.char_at(self.text.char_start(from - 1)).0) do from = self.text.char_start(from - 1)
            while to < hi && is_word(self.char_at(to).0) do to += self.char_at(to).1

        self.anchor = Some(from)
        self.place(to, self.line)
    end select_word

    /** Puts the selection on the clipboard, and on the system's when it is small enough to send;
     * `did` is the word the status bar says it with. False when nothing is selected.
     */
    copy(*self, did: string) -> bool
        if self.selection() is Some((from, to))
            val n = to - from

            self.clip = self.text.slice(from, to)
            if n <= osc52_limit
                self.outbox.extend(osc52(self.text.bytes(from, to).view()).view())
                self.message = s"$did ${amount(n)}"
            else
                self.message = s"$did ${amount(n)}, too much for the system clipboard (${amount(osc52_limit)} at most): paste it in te"
            return true

        self.message = "Nothing is selected"
        false
    end copy

    cut(*self)
        if self.copy("Cut") then self.erase()

    /** The clipboard, over the selection if there is one, as one undo step. */
    paste(*self)
        if self.clip is None
            self.message = "Nothing has been copied"
            return

        val since = self.text.now
        val piece = self.clip

        self.erase()

        val before = (self.at, self.line)

        self.colours.edit(self.at, 0, slice_size(piece))
        self.text.insert_slice(self.at, piece)
        self.at += slice_size(piece)
        self.line += self.text.slice_lines(piece)
        self.edited(before)
        self.group(since)
    end paste

    /** Text the terminal pasted: inserted as it is, never indented, as one undo step. A terminal sends
     * a pasted line break as a carriage return, so a lone one is a line feed again.
     */
    paste_text(*self, text: string)
        val b = text.bytes
        var bytes: Buf[u8] = buf()

        for i in 0..<b.len
            if b[i] == u8('\r') && (i + 1 == b.len || b[i + 1] != u8('\n')) then bytes.push(u8('\n')) else bytes.push(b[i])

        if bytes.len() == 0 then return

        val since = self.text.now

        self.erase()
        self.insert(bytes.view())
        self.group(since)
    end paste_text

    // ---- searching ---------------------------------------------------------------------------

    /** Whether a search is running. */
    busy(self) -> bool = self.hunt is Some(_)

    /** Opens the find or the replace prompt. */
    find(*self, replacing: bool)
        self.prompt = if replacing then Replacing else Finding
        self.entry.clear()
        self.origin = (self.at, self.line)

    /** The query typed so far changed: search again from where the prompt opened. */
    requery(*self)
        self.query.clear()
        self.query.extend(self.entry.view())
        self.hunt = None
        self.anchor = None
        self.place(self.origin.0, self.origin.1)
        if self.query.len() > 0 then self.start(Show, false, self.at) else self.lit = false

    /** F3 and Shift+F3: the next match after the cursor, or the one before the selection. */
    next(*self, back: bool)
        if self.query.len() == 0 then return self.find(false)

        val from = if back && self.selection() is Some((f, _)) then f else self.at

        self.start(Show, back, from)

    /** Starts a search from `from`. */
    start(*self, goal: Goal, back: bool, from: u64)
        val size = self.text.size()
        val limit = if back then 0 else size

        self.lit = true
        self.hunt = Some(Hunt(goal, back, from, limit, from, goal == ReplaceAll, 0, 0, self.text.now, self.at))

    /** Whether there is work to do between keys: a search, or lines still to count. */
    pending(self) -> bool = self.busy() || !self.text.lines_known()

    /** Looks through up to `budget` more bytes for the search in progress, or with none, counts up to
     * `budget` more bytes of lines; a `far` cursor learns its line once they are all counted. True
     * when the screen may show something new: a search's progress, the line total once it is known,
     * the lines a `far` cursor is at least on.
     */
    work(*self, budget: u64) -> bool
        if self.hunt is Some(h)
            self.step(h, budget)
            return true

        val far = self.far

        if self.text.count_some(budget)
            self.settle()
            return true

        far

    /** Runs the search in progress to its end. */
    finish(*self)
        while self.busy() do self.work(search_step)

    private step(*self, hunt: Hunt, budget: u64)
        var h = hunt
        val n = u64(self.query.len())
        val needle = prepared(self.query.view(), self.match_case)
        val size = self.text.size()

        if h.back
            val lo = if h.pos > h.limit + budget then h.pos - budget else h.limit
            val window = self.text.bytes(lo, min(h.pos + n - 1, size))

            self.searched += u64(window.len())
            if last_match(window.view(), needle.view(), self.match_case, usize(h.pos - lo)) is Some(i) then return self.found(h, lo + u64(i))
            h.done += h.pos - lo
            h.pos = lo
        else
            val hi = min(h.pos + budget, h.limit)
            val window = self.text.bytes(h.pos, min(hi + n - 1, size))

            self.searched += u64(window.len())
            if h.goal == ReplaceAll then return self.replace_window(h, window.view(), needle.view(), hi)
            if first_match(window.view(), needle.view(), self.match_case, usize(hi - h.pos)) is Some(i) then return self.found(h, h.pos + u64(i))
            h.done += hi - h.pos
            h.pos = hi

        if h.pos != h.limit then
            self.hunt = Some(h)
        elif h.wrapped then
            self.hunt = None
            self.not_found(h)
        else
            h.wrapped = true
            h.pos = if h.back then size else 0
            h.limit = h.origin
            self.hunt = Some(h)
    end step

    /** A match at `at`: selected, with the cursor after it. */
    private found(*self, h: Hunt, at: u64)
        val end = at + u64(self.query.len())

        self.hunt = None
        self.anchor = Some(at)
        self.place(end, self.text.line_of(end))
        if h.wrapped then self.message = if h.back then "Search wrapped to the end" else "Search wrapped to the start"
        if h.goal == Ask then self.prompt = Confirming
        self.follow()

    private not_found(*self, h: Hunt)
        self.message = s"Not found: ${from_utf8_lossy(self.query.view())}"
        if h.goal == Ask then self.prompt = Idle

    /** Replace-all over one window: every match starting before `hi`, replaced from the last back so
     * that the offsets of the ones before stay true, as part of the one undo step the replace-all is.
     */
    private replace_window(*self, hunt: Hunt, window: []const u8, needle: []const u8, hi: u64)
        var h = hunt
        val n = u64(needle.len)
        val r = u64(self.replacement.len())
        var starts: Buf[u64] = buf()
        var i: usize = 0
        val below = usize(hi - h.pos)

        while i < below && first_match(window[i..], needle, self.match_case, below - i) is Some(k)
            starts.push(h.pos + u64(i + k))
            i += k + needle.len

        // A match runs at most `n - 1` bytes past `hi`, so the next window starts after the last one.
        var next = hi

        if starts.len() > 0 then next = max(hi, starts[starts.len() - 1] + n)

        var k = starts.len()

        while k > 0
            k -= 1

            val at = starts[k]

            self.colours.edit(at, n, r)
            self.text.delete(at, n)
            self.text.insert(at, self.replacement.view())
            if h.keep >= at + n then
                h.keep = h.keep + r - n
            elif h.keep > at
                h.keep = at + r

        self.text.squash(h.since)

        val grew = u64(starts.len()) * r
        val shrank = u64(starts.len()) * n

        h.count += u64(starts.len())
        h.done += next - h.pos
        h.pos = next + grew - shrank
        h.limit = h.limit + grew - shrank
        if h.pos >= h.limit
            self.hunt = None
            self.replaced(h, false)
        else
            self.hunt = Some(h)
    end replace_window

    /** A replace-all is over, or stopped: the cursor where it was in the text, and one undo step. */
    private replaced(*self, h: Hunt, stopped: bool)
        val before = (self.at, self.line)

        self.prompt = Idle
        if stopped then
            self.message = s"Replaced ${h.count}, then stopped"
        elif h.count == 0 then
            self.message = s"Not found: ${from_utf8_lossy(self.query.view())}"
        else
            self.message = s"Replaced ${h.count}"
        if h.count == 0 then return

        self.at = h.keep
        self.line = self.text.line_of(h.keep)
        self.edited(before)
        self.follow()

    /** Esc during a search. */
    cancel(*self)
        if self.hunt is Some(h)
            self.hunt = None
            if h.goal == ReplaceAll then return self.replaced(h, true)

            self.message = "Search stopped"
            if self.prompt == Finding then self.place(self.origin.0, self.origin.1)

    /** Y in the replace prompt: this match replaced, as one undo step, and on to the next. */
    replace_one(*self)
        val since = self.text.now

        self.erase()
        self.insert(self.replacement.view())
        self.group(since)
        self.start(Ask, false, self.at)

    // ---- saving and quitting -----------------------------------------------------------------

    /** Saves to the document's name, or asks for one, or asks first when the file has changed on disk
     * since it was opened, saved or reloaded; true when the text is now on disk.
     */
    save(*self) -> bool
        if self.text.path.len == 0
            self.prompt = Naming
            self.entry.clear()
            return false

        if self.text.changed_on_disk()
            self.prompt = Overwriting
            return false

        self.save_as(self.text.path)

    /** Ctrl+L: the file as it is on disk now, as a new version an undo goes back from, with the cursor
     * kept on its line and column where the file still has them.
     */
    reload(*self)
        if self.text.path.len == 0
            self.message = "Nothing to reload: the text has no file"
            return

        val before = (self.at, self.line)
        val col = self.column(self.line, self.at).0

        if self.text.reload() is Err(e)
            self.message = s"Could not reload ${self.text.path}: $e"
            return

        self.colours.forget()

        val line = if self.has_line(self.line) then self.line else self.last_line()

        self.place(self.at_column(line, col), line)
        self.edited(before)
        self.message = s"Reloaded ${self.text.path}"

    /** Saves to `path`; a new name is read with the grammar its extension names. */
    save_as(*self, path: string) -> bool
        val renamed = path != self.text.path

        self.text.save_as(path) match
            Ok(_) ->
                if renamed then self.colours.redetect(path, head(self.text).view())
                self.message = s"Saved $path"
                true
            Err(e) ->
                self.message = s"Could not save $path: $e"
                false
    end save_as

    /** Ctrl+E: the syntax colours off, or on again. */
    toggle_colours(*self)
        if self.colours.hl is None
            self.message = "No colours: the file's language is not known"
            return

        self.colours.on = !self.colours.on
        self.message = if self.colours.on then "Colours on" else "Colours off"
    end toggle_colours

    quit(*self)
        if self.text.modified() then self.prompt = Quitting else self.done = true

    // ---- input -------------------------------------------------------------------------------

    /** Does what `input` asks. */
    handle(*self, input: Input)
        if input is Resized(w, h)
            self.w = w
            self.h = h
            if self.far then self.frame_far()
            return self.follow()

        if self.far && !self.stays_far(input) then self.settle()

        self.message = ""
        self.last_streak = self.streak
        self.streak = Quiet

        // While a search runs, Esc stops it and the find prompt still takes keys; the rest waits.
        if self.busy()
            if input is Press(Esc, _, _) then return self.cancel()
            if self.prompt != Finding && input is not Wheel(_) then return

        if input is Wheel(n) then return self.scroll(n)

        if self.prompt != Idle
            self.answer(input)
        else
            input match
                Type(c) -> self.type_char(c)
                Press(key, ctrl, shift) -> self.press(key, ctrl, shift)
                Click(x, y) -> self.click(x, y)
                Drag(x, y) -> self.drag(x, y)
                Paste(text) -> self.paste_text(text)
                _ -> ()

        self.follow()
    end handle

    press(*self, key: Key, ctrl: bool, shift: bool)
        key match
            Left -> if shift || !self.collapse(true)
                self.extend(shift)
                if ctrl then self.word_left() else self.left_one()
            Right -> if shift || !self.collapse(false)
                self.extend(shift)
                if ctrl then self.word_right() else self.right_one()
            Up ->
                self.extend(shift)
                self.vertical(-1)
            Down ->
                self.extend(shift)
                self.vertical(1)
            PageUp ->
                self.extend(shift)
                self.page(-1)
            PageDown ->
                self.extend(shift)
                self.page(1)
            Home ->
                self.extend(shift)
                if ctrl then self.place(0, 0) else self.home()
            End ->
                self.extend(shift)
                if ctrl then self.to_end() else self.place(self.text.line_end(self.line), self.line)
            Enter -> self.enter()
            Tab -> self.type_char('\t')
            Space -> self.type_char(' ')
            Backspace | Backspace2 -> self.erase_key(true)
            Delete -> self.erase_key(false)
            CtrlA -> self.select_all()
            CtrlC -> self.copy("Copied")
            CtrlX -> self.cut()
            CtrlV -> self.paste()
            CtrlF -> self.find(false)
            CtrlR -> self.find(true)
            F3 -> self.next(shift)
            Esc ->
                self.anchor = None
                self.lit = false
            CtrlZ -> self.undo()
            CtrlY -> self.redo()
            CtrlS -> self.save()
            CtrlQ -> self.quit()
            CtrlL | F5 -> self.reload()
            CtrlE -> self.toggle_colours()
            CtrlG ->
                self.prompt = GoingTo
                self.entry.clear()
            _ -> ()
    end press

    /** A key while the status bar is asking something. */
    answer(*self, input: Input)
        if self.prompt == Quitting
            input match
                Type(c) ->
                    if c == 'y' || c == 'Y'
                        self.prompt = Idle
                        self.quit_after = true
                        if self.save() then self.done = true
                    elif c == 'n' || c == 'N'
                        self.done = true
                Press(key, _, _) -> if key == Esc || key == CtrlC || key == CtrlQ then self.prompt = Idle
                _ -> ()
            return

        if self.prompt == Overwriting
            input match
                Type(c) ->
                    if c == 'y' || c == 'Y'
                        self.prompt = Idle
                        if self.save_as(self.text.path) && self.quit_after then self.done = true
                        self.quit_after = false
                    elif c == 'n' || c == 'N'
                        self.prompt = Idle
                        self.quit_after = false
                        self.message = "Not saved"
                Press(key, _, _) -> if key == Esc || key == CtrlC || key == CtrlQ
                    self.prompt = Idle
                    self.quit_after = false
                    self.message = "Not saved"
                _ -> ()
            return

        if self.prompt == Confirming
            input match
                Type(c) ->
                    if c == 'y' || c == 'Y'
                        self.replace_one()
                    elif c == 'n' || c == 'N'
                        self.start(Ask, false, self.at)
                    elif c == 'a' || c == 'A'
                        self.anchor = None
                        self.start(ReplaceAll, false, 0)
                Press(key, _, _) -> key match
                    Enter -> self.replace_one()
                    Esc | CtrlC | CtrlQ -> self.prompt = Idle
                    _ -> ()
                _ -> ()
            return

        val finding = self.prompt == Finding

        input match
            Type(c) ->
                self.entry.extend(string(c).bytes)
                if finding then self.requery()
            Press(key, _, shift) -> key match
                Space ->
                    self.entry.push(u8(' '))
                    if finding then self.requery()
                Backspace | Backspace2 ->
                    pop_char(&self.entry)
                    if finding then self.requery()
                CtrlT -> if finding || self.prompt == Replacing
                    self.match_case = !self.match_case
                    if finding && self.entry.len() > 0 then self.requery()
                F3 -> if finding then self.next(shift)
                Enter -> self.submit()
                Esc | CtrlC | CtrlQ ->
                    self.prompt = Idle
                    self.quit_after = false
                _ -> ()
            _ -> ()
    end answer

    /** The answer typed into a prompt. */
    submit(*self)
        val asked = self.prompt
        val entry = from_utf8_lossy(self.entry.view())

        if asked == Finding then return self.next(false)

        if asked == Replacing
            if self.entry.len() > 0 then
                self.query.clear()
                self.query.extend(self.entry.view())
            if self.query.len() == 0
                self.prompt = Idle
                self.message = "Nothing to find"
            else
                self.prompt = ReplacingWith
                self.entry.clear()
            return

        if asked == ReplacingWith
            self.replacement.clear()
            self.replacement.extend(self.entry.view())
            self.prompt = Idle

            val from = if self.selection() is Some((f, _)) then f else self.at

            return self.start(Ask, false, from)

        self.prompt = Idle
        if asked == GoingTo
            self.go(entry)
        elif entry.len == 0
            self.message = "Not saved"
        elif self.save_as(entry) && self.quit_after
            self.done = true

        self.quit_after = false
        self.follow()
    end submit

    /** `line` or `line:column`, both counted from 1. */
    go(*self, entry: string)
        val parts = split(entry, ":")
        val line = parse_ulong(parts[0]).unwrap_or(0)
        val col = if parts.len > 1 then parse_ulong(parts[1]).unwrap_or(0) else 1

        if parts.len > 2 || line == 0 || col == 0
            self.message = s"Not a line number: $entry"
        else
            self.goto(line - 1, col - 1)

    /** A click places the cursor and is where a drag selects from; a second one in the same place
     * soon after selects the word there.
     */
    click(*self, x: int, y: int)
        if y < 0 || u64(y) >= self.rows() then return

        val double = self.clock - self.click_clock <= double_click && self.click_at == (x, y)

        self.click_clock = self.clock
        self.click_at = (x, y)
        self.point(x, y)
        self.anchor = Some(self.at)
        if double then self.select_word()

    /** The mouse moved with the button held: the selection runs from where it was pressed. */
    drag(*self, x: int, y: int)
        if self.anchor is None then self.anchor = Some(self.at)
        self.point(x, y)

    /** The cursor at a screen position: a row past the text is its last line, and a row above or below
     * the view is the line just beyond it, so a drag there scrolls a line at a time.
     */
    point(*self, x: int, y: int)
        val rows = self.rows()
        var line = if y < 0 then self.top - min(self.top, 1) elif u64(y) >= rows then self.top + rows else self.top + u64(y)

        if !self.has_line(line) then line = self.last_line()

        val g = self.gutter()
        val col = if x > 0 && u64(x) > g then u64(x) - g else 0

        self.place(self.at_column(line, self.left + col), line)

    /** Moves the view, not the cursor; never past the last line. */
    scroll(*self, by: int)
        if by < 0 then
            self.top -= min(self.top, u64(-by))
        else
            var top = self.top + u64(by)

            while top > self.top && !self.has_line(top) do top -= 1
            self.top = top

    /** Moves the view so that the cursor is on it. */
    follow(*self)
        val rows = self.rows()

        // A `far` screen is the last lines of the text, whatever `top` says.
        if !self.far
            if self.line < self.top then
                self.top = self.line
            elif self.line >= self.top + rows then
                self.top = self.line - rows + 1

        val (start, end) = self.cursor_line()
        val col = self.column_in(start, end, self.at).0
        val width = self.text_width()

        if col < self.left then
            self.left = col
        elif col >= self.left + width then
            self.left = col - width + 1
    end follow

    // ---- drawing -----------------------------------------------------------------------------

    render(*self, g: *Grid)
        g.reset(self.w, self.h)

        val rows = self.rows()
        val gutter = self.gutter()
        val width = self.text_width()

        // A `far` screen's lines have no numbers yet, so none are shown.
        if self.far
            for i in 0..<self.far_rows.len()
                val (start, end) = self.far_line(i)

                self.draw_line(g, start, end, int(i), gutter, width)
        else
            for y in 0..<rows
                val n = self.top + y

                if !self.has_line(n) then break

                val label = s"${n + 1}"
                val (start, end) = self.bounds(n)

                g.write(int(gutter - 1 - label.len), int(y), label, DIM, DEFAULT)
                self.draw_line(g, start, end, int(y), gutter, width)

        if self.h > 1 then self.status(g, int(rows))
        if self.h > 2 then self.keys(g, int(rows) + 1)

        if self.typing_in_prompt() then return

        val (start, end) = self.cursor_line()
        val (col, _) = self.column_in(start, end, self.at)
        val row = if self.far then u64(self.far_rows.len() - 1) else self.line - min(self.line, self.top)

        if (self.far || self.line >= self.top) && row < rows && col >= self.left && col < self.left + width
            g.cursor = Some((int(gutter + col - self.left), int(row)))
    end render

    /** Whether the reader is typing into the status bar, which then has the cursor. */
    typing_in_prompt(self) -> bool =
        self.prompt == GoingTo || self.prompt == Naming || self.prompt == Finding || self.prompt == Replacing || self.prompt == ReplacingWith

    /** The line whose text is `start..<end`, the part of it in view. The selection is drawn reversed,
     * a selected line break as one reversed cell after the text, the query's matches black on
     * yellow, and the rest in its syntax colours.
     *
     * **A long line is drawn a byte to a column** (`long_line`), so drawing starts at the first byte in
     * view rather than at the line's start: a character takes as many columns as it has bytes, its
     * glyph in the first of them and blanks after, and a tab is one column.
     */
    draw_line(*self, g: *Grid, start: u64, end: u64, y: int, gutter: u64, width: u64)
        val long = end - start > long_line
        val stop = self.left + width
        val (from, to) = self.selection().unwrap_or((0, 0))
        var off = if long then self.text.char_start(min(start + self.left, end)) else start
        val hits = self.hits(start, off, end, if long then min(end, start + stop) else self.at_column_in(start, end, stop))
        val shade = self.colours.shade(&self.text, start, end)
        val hit = (self.colours.scheme.hit_fg, self.colours.scheme.hit_bg)
        var h: usize = 0
        var s: usize = 0
        var col = off - start
        var last = -1

        while off < end && col < stop
            val (c, len) = self.char_at(off)
            val span = if long then len else cells(c, col, self.tab)
            val shown = if long && c != '\t' then cells(c, 0, self.tab) else span

            while h < hits.len() && hits[h].1 <= off do h += 1
            while s < shade.len() && start + shade[s].0 <= off do s += 1

            val (fg, bg) = if off >= from && off < to then
                (DEFAULT | REVERSE, DEFAULT)
            elif h < hits.len() && hits[h].0 <= off then
                hit
            elif s < shade.len() then
                (shade[s].1, DEFAULT)
            else
                (DEFAULT, DEFAULT)

            if c == '\t'
                for i in 0..<span
                    if col + i >= self.left && col + i < stop then g.put(int(gutter + col + i - self.left), y, u32(' '), fg, bg)
            elif shown > 0 && col >= self.left && col + shown <= stop
                val ch = if wcwidth(u32(c)) < 0 then 0xFFFD else u32(c)

                last = int(gutter + col - self.left)
                g.glyph(last, y, ch, int(shown), fg, bg)
            elif shown == 0 && last >= 0
                g.extend(last, y, u32(c))
            else
                last = -1

            // A long line's columns past the glyph: the rest of the character's bytes.
            for i in shown..<span
                if col + i >= self.left && col + i < stop then g.put(int(gutter + col + i - self.left), y, u32(' '), fg, bg)

            col += span
            off += len

        // On a long line the marks on the last glyph in view have columns past it, and still show.
        while long && last >= 0 && off < end && is_mark(self.char_at(off).0)
            g.extend(last, y, u32(self.char_at(off).0))
            off += self.char_at(off).1

        if end >= from && end < to && col >= self.left && col < stop then g.put(int(gutter + col - self.left), y, u32(' '), DEFAULT | REVERSE, DEFAULT)
    end draw_line

    /** Where the query matches between `from` and `upto` on the line whose text is `start..<end`,
     * counting one that begins before `from` and reaches into it, when matches are shown.
     */
    hits(*self, start: u64, from: u64, end: u64, upto: u64) -> Buf[(u64, u64)]
        var out: Buf[(u64, u64)] = buf()

        if !self.lit || self.query.len() == 0 then return out

        val len = self.query.len()
        val lo = max(start, from - min(from, u64(len)))
        val hay = self.text.bytes(lo, min(end, upto + 4 + u64(len)))
        val needle = prepared(self.query.view(), self.match_case)
        var i: usize = 0

        while i < hay.len() && first_match(hay.view()[i..], needle.view(), self.match_case, hay.len() - i) is Some(k)
            out.push((lo + u64(i + k), lo + u64(i + k + len)))
            i += k + len

        out
    end hits

    /** The file, whether it is modified, and where the cursor is -- or the question being asked. */
    status(*self, g: *Grid, y: int)
        for x in 0..<self.w do g.put(x, y, u32(' '), DEFAULT | REVERSE, DEFAULT)

        val entry = from_utf8_lossy(self.entry.view())
        val case = if self.match_case then "match case" else "any case"
        val say = self.prompt match
            Quitting -> "Save changes before quitting?"
            GoingTo -> s"Go to line: $entry"
            Naming -> s"Save as: $entry"
            Finding -> s"Find ($case): $entry"
            Replacing -> s"Replace ($case): $entry"
            ReplacingWith -> s"Replace ${from_utf8_lossy(self.query.view())} with: $entry"
            Confirming -> s"Replace this with ${from_utf8_lossy(self.replacement.view())}?"
            Overwriting -> "The file has changed on disk since it was opened. Save over it?"
            Idle -> if self.message.len > 0 then self.message else self.title()

        val end = g.write(1, y, say, DEFAULT | REVERSE | BOLD, DEFAULT)

        // What a search is doing, or what it found, beside the question the prompt is asking.
        val note = if self.hunt is Some(h) then
            s"Searching, ${percent(h.done, self.text.size())} (Esc stops)"
        elif self.prompt != Idle then
            self.message
        else
            ""
        val noted = if note.len > 0 then g.write(end + 2, y, note, DEFAULT | REVERSE, DEFAULT) else end

        if self.typing_in_prompt()
            g.cursor = Some((end, y))
            return

        // A `far` cursor's line is only known to be at least the lines counted so far; on a long line
        // the column is a byte.
        val (lo, hi) = self.cursor_line()
        val (_, chars) = self.column_in(lo, hi, self.at)
        val total = if self.text.lines_known() then s" of ${self.text.line_count()}" else ""
        val line = if self.far then s"≥ ${self.text.lines_at_least()}" else s"${self.line + 1}$total"
        val col = if hi - lo > long_line then "Byte" else "Col"
        val place = s"Ln $line, $col ${chars + 1} "
        var room = 0

        for _ in place.chars do room += 1

        if noted + 2 + room <= self.w then g.write(self.w - room, y, place, DEFAULT | REVERSE, DEFAULT)
    end status

    title(self) -> string
        val name = if self.text.path.len > 0 then self.text.path else "[No name]"

        if self.text.modified() then s"$name (modified)" else name

    /** The keys that work now, the way nano shows them. */
    keys(*self, g: *Grid, y: int)
        val idle: []const (string, string) = [("^S", "Save"), ("^Q", "Quit"), ("^F", "Find"), ("^R", "Replace"),
            ("^Z", "Undo"), ("^Y", "Redo"), ("^C", "Copy"), ("^X", "Cut"), ("^V", "Paste"), ("^A", "All"), ("^G", "Go to line"), ("^L", "Reload"), ("^E", "Colours")]
        val shown: []const (string, string) = if self.busy() then [("Esc", "Stop")] else self.prompt match
            Idle -> idle
            Quitting -> [("Y", "Yes"), ("N", "No"), ("Esc", "Cancel")]
            GoingTo -> [("Enter", "Go"), ("Esc", "Cancel")]
            Naming -> [("Enter", "Save"), ("Esc", "Cancel")]
            Finding -> [("Enter", "Next"), ("Shift+F3", "Previous"), ("^T", "Match case"), ("Esc", "Done")]
            Replacing -> [("Enter", "Next"), ("^T", "Match case"), ("Esc", "Cancel")]
            ReplacingWith -> [("Enter", "Start"), ("Esc", "Cancel")]
            Confirming -> [("Y", "Replace"), ("N", "Skip"), ("A", "All"), ("Esc", "Stop")]
            Overwriting -> [("Y", "Save over it"), ("N", "Don't save"), ("Esc", "Cancel")]

        var x = 0

        // A key is shown whole or not at all, the most used first.
        for (key, label) in shown
            if x + int(key.len + 1 + label.len) > self.w then break
            x = g.write(x, y, key, DEFAULT | REVERSE, DEFAULT)
            x = g.write(x + 1, y, label, DEFAULT, DEFAULT) + 2
    end keys
end Editor

/** An editor over `text`, on a screen `w` by `h`. */
editor(text: Text, w: int = 80, h: int = 24, tab: u64 = tab_width) -> Editor
    var before: Buf[Spot] = buf()
    var after: Buf[Spot] = buf()

    val colours = colours_for(text.path, head(text).view())

    before.push((0, 0))
    after.push((0, 0))
    Editor(text, 0, 0, None, 0, 0, w, h, tab, Idle, buf(), false, "", false, before, after, None, None, buf(), 0,
        Quiet, Quiet, ' ', 0, -double_click - 1, (-1, -1), buf(), buf(), false, false, (0, 0), None, 0, false, buf(), colours)

/** The editor for `te <path>`: the file, a new file of that name where there is none, or an unnamed
 * buffer for an empty path. Any other failure to open it is the error.
 */
load(path: string) -> Result[Editor, string]
    if path.len == 0 then return Ok(editor(empty("")))

    open(path) match
        Ok(t) ->
            var ed = editor(t)

            if ed.text.size() >= big_file then ed.message = s"$path, ${amount(ed.text.size())} (counting lines)"
            Ok(ed)
        Err(NotFound) ->
            var ed = editor(empty(path))

            ed.message = s"New file $path"
            Ok(ed)
        Err(e) -> Err(s"$path: $e")
end load

/** How many screen columns `c` takes at column `col`. A character with no printed form is drawn as
 * U+FFFD, one column.
 */
cells(c: char, col: u64, tab: u64) -> u64
    if c == '\t' then return tab - col % tab

    val w = wcwidth(u32(c))

    if w < 0 then 1 else u64(w)

/** A combining mark or another character drawn on the one before it. */
is_mark(c: char) -> bool = c != '\t' && wcwidth(u32(c)) == 0

/** What a Ctrl+arrow word move stops at the edges of. */
is_word(c: char) -> bool =
    c == '_' || (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || u32(c) >= 0x80

is_blank(b: u8) -> bool = b == u8(' ') || b == u8('\t')

/** A byte count the way the status bar says it. */
amount(n: u64) -> string
    if n == 1 then return "1 byte"
    if n < 1 << 10 then return s"$n bytes"
    if n < 1 << 20 then return s"${n >> 10} KiB"
    if n < 1 << 30 then return s"${n >> 20} MiB"

    s"${n >> 30}.${(n & ((1 << 30) - 1)) * 10 >> 30} GiB"

/** `part` of `whole`, as a percentage. */
percent(part: u64, whole: u64) -> string = s"${if whole == 0 then 100 else min(part * 100 / whole, 100)}%"

private first_char(b: []const u8) -> (char, u64)
    var cs = chars_of(b)
    val c = cs.next().unwrap()

    (c, cs.offset)

private digits(n: u64) -> u64
    var d: u64 = 1
    var m = n

    while m >= 10
        m /= 10
        d += 1

    d

/** Removes the last character of `b`. */
private pop_char(b: *Buf[u8])
    while b.pop() is Some(x) && (x & 0xC0) == 0x80 do ()
